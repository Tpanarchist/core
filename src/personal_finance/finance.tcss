$base: #141716;
$surface: #1f2928;
$raised: #203536;
$primary: #f8ffbb;
$secondary: #c1c2fa;
$subtle: #6a8ba7;
$cyan: #22c6bc;

Screen { background: $base; color: $primary; }
#masthead { height: 3; padding: 1 1 0 1; background: $surface; }
#context-bar { height: 2; padding: 0 2; color: $secondary; background: $surface; }
TabbedContent { height: 1fr; }
Tabs { background: $surface; }
Tab { color: $secondary; padding: 0 1; }
Tab.-active { color: $primary; text-style: bold; background: $raised; }
Underline > .underline--bar { color: $cyan; }
TabPane { padding: 0 1; }
.summary { height: auto; min-height: 3; padding: 1; color: $primary; background: $raised; }
.view-body { height: 1fr; }
.text-view { width: 2fr; height: 1fr; border: solid $raised; padding: 0 1; }
.graph-view { width: 1fr; min-width: 29; height: 1fr; border: solid $raised; padding: 1; }
.text-view > Static { height: auto; margin: 1 0; }
.graph-view > Static { height: auto; margin-bottom: 1; }
.section-title { color: $cyan; text-style: bold; height: auto; margin-bottom: 1; }
.muted { color: $secondary; height: auto; }
.warning { color: #ea6be8; height: auto; margin: 1 0; }
.error { color: #ff334e; background: $base; }
.deferred-panel { height: 1fr; padding: 2 3; border: solid $raised; }
.deferred-panel > Static { margin-bottom: 1; }
DataTable { height: 1fr; min-height: 5; background: $base; color: $primary; }
DataTable > .datatable--header { background: $raised; color: $secondary; text-style: bold; }
DataTable > .datatable--odd-row { background: $surface; }
DataTable > .datatable--cursor { background: #3d2b79; color: $primary; }
#action-bar { height: 3; background: $surface; padding: 0 1; }
#action-bar Button { margin-right: 1; min-width: 10; height: 3; }
#mode-hints { width: 1fr; height: 3; content-align: right middle; color: $secondary; }
#status { height: auto; min-height: 1; max-height: 3; padding: 0 2; background: $raised; }
#status.error { background: $base; }
Footer { background: $surface; color: $secondary; }
Footer > .footer--key { background: $raised; color: $cyan; }
Button { background: $raised; color: $primary; border: tall $raised; }
Button.-primary { background: #1b7e51; color: $primary; border: tall #1b7e51; }
Button:focus { border: tall $cyan; text-style: bold; }
ModalScreen { align: center middle; background: $base 80%; }
.dialog { width: 68; max-width: 96%; height: auto; max-height: 94%; padding: 1 2;
          border: heavy $cyan; background: $surface; }
.wide-dialog { width: 86; }
.dialog > Label { margin-top: 1; }
.dialog-title { color: $cyan; text-style: bold; margin-bottom: 1; }
.dialog > Static { height: auto; }
.dialog-buttons { height: 3; margin-top: 1; }
.dialog-buttons Button { margin-right: 1; min-width: 14; }
Input, Select, TextArea { background: $base; color: $primary; border: solid $raised; }
Input:focus, TextArea:focus { border: solid $cyan; }
Select:focus { border: solid $cyan; }
SelectOverlay { background: $surface; color: $primary; }
Checkbox { background: $surface; color: $primary; }
#entry-splits { height: 6; }
#form-error { color: #ff334e; background: $base; margin-top: 1; }
.compact .view-body { layout: vertical; }
.compact .text-view { width: 1fr; height: 2fr; }
.compact .graph-view { width: 1fr; height: 1fr; min-width: 0; }
.compact .text-view > Static { display: none; }
.compact #mode-hints { display: none; }
.compact #masthead { height: 2; padding: 0 1; }
.compact #context-bar { height: 2; }
#cash-controls { height: 3; background: $surface; }
#debts .model-controls, #assets .model-controls, #nodes .model-controls,
#reconcile .model-controls {
    height: 3; background: $surface;
}
.model-controls Button { min-width: 20; margin-right: 2; height: 3; }
#cash-controls Button { min-width: 10; margin-right: 1; height: 3; }
#cash-controls #cash-manage { min-width: 19; }
#cash-key-hints { width: 1fr; height: 3; content-align: right middle; color: $secondary; }
#cash-summary { max-height: 7; overflow-y: auto; }
#cash-graph { min-width: 40; }
#cash-text-content { max-height: 10; overflow-y: auto; }
.cash-menu-action { width: 100%; margin-top: 1; }
#cash-form-error { height: auto; margin-top: 1; }
.cash-input-dialog Checkbox { height: auto; min-height: 3; }
.cash-input-dialog #cash-save { min-width: 22; }
.cash-input-dialog #model-save { min-width: 22; }
.compact #cash-key-hints { display: none; }
.compact #cash-text-content { display: block; max-height: 4; margin: 0; }
.compact #cash-summary { padding: 0 1; min-height: 2; max-height: 3; }
.compact #cash-graph { min-width: 0; }
